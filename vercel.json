    { "source": "/bem-vindo", "destination": "/", "permanent": true },
    { "source": "/sintomas", "destination": "/", "permanent": true },
    { "source": "/gmn", "destination": "/?utm_source=google_meu_negocio&utm_medium=perfil", "permanent": false },
    { "source": "/insta", "destination": "/?utm_source=instagram&utm_medium=bio", "permanent": false },
    { "source": "/terapia", "destination": "/", "permanent": true },
    { "source": "/termos", "destination": "/termos-de-uso", "permanent": true },
